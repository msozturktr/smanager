    # ---------------- yaşam döngüsü
    def do_activate(self):
        if self.win:
            self.show_window()
            return
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", True)
        self.build_window()
        self.build_tray()
        self.server = re.sub(r".*\(on (.*)\)", r"\1",
                             re.search(r"Server Name: (.*)", pactl("info")).group(1)).upper()
        self.server_lbl.set_text(f"TELEMETRİ // {self.server}")
        self.refresh()
        self.start_subscribe()
        if "--gizli" in sys.argv:
            # tepside başla; panel hazır değilse (simge görünmüyorsa) pencereyi aç
            self.hold()
            GLib.timeout_add_seconds(8, self.ensure_visible)
        else:
            self.win.show_all()

