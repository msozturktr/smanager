class VolumeSlider(Gtk.Scale):
    """Kullanıcı sürüklerken dışarıdan gelen güncellemeleri yok sayan,
    pactl çağrılarını kısan kaydırıcı."""

    def __init__(self, on_change, main=False):
        adj = Gtk.Adjustment(value=0, lower=0, upper=MAX_VOL, step_increment=1, page_increment=5)
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, adjustment=adj)
        self.set_draw_value(False)
        self.set_hexpand(True)
        self.set_round_digits(0)
        if main:
            self.get_style_context().add_class("main")
            for m, text in ((0, "%0"), (100, "%100 · UNITY"), (200, "%200"), (300, "%300")):
                self.add_mark(m, Gtk.PositionType.BOTTOM, text)
        self._on_change = on_change
        self._dragging = False
        self._quiet_until = 0
        self._pending = None
        self._hid = self.connect("value-changed", self._changed)
        self.connect("button-press-event", lambda *a: setattr(self, "_dragging", True))
        self.connect("button-release-event", self._released)
        self.connect("scroll-event", self._scroll)

    def _scroll(self, _w, ev):
        # tekerlek sesi değiştirmesin, sayfayı kaydırsın
        sw = self.get_ancestor(Gtk.ScrolledWindow)
        if sw:
            adj = sw.get_vadjustment()
            if ev.direction == Gdk.ScrollDirection.SMOOTH:
                delta = ev.get_scroll_deltas()[2] * 60
            else:
                delta = 60 if ev.direction == Gdk.ScrollDirection.DOWN else -60
            adj.set_value(adj.get_value() + delta)
        return True

    def _released(self, *a):
        self._dragging = False
        self._quiet_until = GLib.get_monotonic_time() + 600_000

    def _changed(self, *a):
        self._quiet_until = GLib.get_monotonic_time() + 600_000
        v = clamp(self.get_value())
        if self._pending is None:
            GLib.timeout_add(35, self._flush)
        self._pending = v

    def _flush(self):
        v, self._pending = self._pending, None
        if v is not None:
            self._on_change(v)
        return False

    def set_external(self, v):
        if self._dragging or GLib.get_monotonic_time() < self._quiet_until:
            return
        if clamp(self.get_value()) == v:
            return
        self.handler_block(self._hid)
        self.set_value(v)
        self.handler_unblock(self._hid)

    def set_dim(self, dim):
        set_class(self, "dim", dim)


class ChannelRow(Gtk.Box):
    """Uygulama ya da mikrofon kanalı kartı."""

    def __init__(self, accent, title, sub, on_volume, on_mute):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.accent = None
        ctx = self.get_style_context()
        ctx.add_class("channel")

        top = Gtk.Box(spacing=8)
        self.dot = label("●", "dot")
        top.pack_start(self.dot, False, False, 0)
        self.title = label(title, "ch-name", "mono", ellipsize=3)
        top.pack_start(self.title, True, True, 0)
        val_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.val = label("", "ch-val", "mono", xalign=1.0)
        self.db = label("", "ch-db", "mono", xalign=1.0)
        val_box.pack_start(self.val, False, False, 0)
        val_box.pack_start(self.db, False, False, 0)
        top.pack_end(val_box, False, False, 0)
        self.pack_start(top, False, False, 0)

        self.sub = label(sub, "ch-sub", "mono", ellipsize=3)
        self.pack_start(self.sub, False, False, 0)

        bottom = Gtk.Box(spacing=12)
        self.slider = VolumeSlider(on_volume)
        self.slider.connect("value-changed", lambda s: self._show_value(clamp(s.get_value())))
        bottom.pack_start(self.slider, True, True, 0)
        self.mute_btn = Gtk.Button(label="M", valign=Gtk.Align.CENTER)
        self.mute_btn.get_style_context().add_class("mute")
        self.mute_btn.get_style_context().add_class("small")
        self.mute_btn.connect("clicked", lambda *a: on_mute())
        bottom.pack_start(self.mute_btn, False, False, 0)
        self.pack_start(bottom, False, False, 0)
        self.set_accent(accent)

    def set_accent(self, accent):
        if accent == self.accent:
            return
        for w in (self, self.dot, self.val):
            if self.accent:
                w.get_style_context().remove_class(self.accent)
            w.get_style_context().add_class(accent)
        self.accent = accent

    def _show_value(self, v):
        self.val.set_text(f"%{v}")
        self.db.set_text(fmt_db(pct_to_db(v)))

    def update(self, vol, muted, title=None, sub=None):
        if title is not None:
            self.title.set_text(title)
        if sub is not None:
            self.sub.set_text(sub)
            self.sub.set_visible(bool(sub))
        self.slider.set_external(vol)
        self.slider.set_dim(muted)
        self._show_value(clamp(self.slider.get_value()))
        set_class(self.mute_btn, "on", muted)
        self.mute_btn.set_tooltip_text("Sesi aç" if muted else "Sessize al")


