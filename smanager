#!/usr/bin/env python3
"""smanager — volume control up to 300% plus media control for PipeWire/PulseAudio (GTK3).

Usage:
  smanager             open the window (brings it to the front if already running)
  smanager --hidden    start hidden in the system tray
  smanager up [N]      raise the default output by N points (default 5, max 300)
  smanager down [N]    lower the default output by N points
  smanager mute        toggle mute
"""
import os
import re
import subprocess
import sys
import threading

MAX_VOL = 300
ENV = dict(os.environ, LC_ALL="C")


# ---------------------------------------------------------------- pactl

def pactl(*args, wait=True):
    cmd = ["pactl", *map(str, args)]
    if wait:
        r = subprocess.run(cmd, env=ENV, capture_output=True, text=True)
        return r.stdout
    subprocess.Popen(cmd, env=ENV, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return ""


def parse_list(kind):
    """Parse `pactl list <kind>` output into a list of dicts."""
    out = pactl("list", kind)
    items, cur, in_props = [], None, False
    for line in out.splitlines():
        m = re.match(r"^\S.*#(\d+)$", line)
        if m:
            cur = {"index": int(m.group(1)), "props": {}}
            items.append(cur)
            in_props = False
            continue
        if cur is None or not line.strip():
            continue
        if line.startswith("\t\t") and in_props:
            pm = re.match(r'\s+([\w.]+) = "(.*)"$', line)
            if pm:
                cur["props"][pm.group(1)] = pm.group(2)
            continue
        if line.startswith("\t") and not line.startswith("\t\t"):
            key, _, val = line.strip().partition(":")
            in_props = key == "Properties"
            cur[key] = val.strip()
    for it in items:
        pcts = [int(p) for p in re.findall(r"(\d+)%", it.get("Volume", ""))]
        it["volume"] = max(pcts) if pcts else 0
        it["mute"] = it.get("Mute") == "yes"
    return items


def _die_with_parent():
    """Make a child process exit when the app dies (even on kill -9)."""
    try:
        import ctypes
        ctypes.CDLL("libc.so.6").prctl(1, 15)  # PR_SET_PDEATHSIG, SIGTERM
    except OSError:
        pass


def default_sink():
    return pactl("get-default-sink").strip()


def default_source():
    return pactl("get-default-source").strip()


def clamp(v):
    return max(0, min(MAX_VOL, int(round(v))))


# ---------------------------------------------------------------- CLI

def cli(argv):
    cmd = argv[0]
    step = int(argv[1]) if len(argv) > 1 else 5
    sink = default_sink()
    if cmd == "mute":
        pactl("set-sink-mute", sink, "toggle")
        return 0
    cur = next((s["volume"] for s in parse_list("sinks") if s.get("Name") == sink), 100)
    new = clamp(cur + step if cmd == "up" else cur - step)
    pactl("set-sink-mute", sink, "0")
    pactl("set-sink-volume", sink, f"{new}%")
    return 0


if len(sys.argv) > 1 and sys.argv[1] in ("up", "down", "mute"):
    sys.exit(cli(sys.argv[1:]))


