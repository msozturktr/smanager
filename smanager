    # ---------------- analysis
    def start_analyzer(self):
        if self.sink:
            self.analyzer.start(self.sink + ".monitor")
        if not self._anim:
            self._anim = GLib.timeout_add(50, self.animate)
            self._anim_n = 0

    def stop_analyzer(self):
        self.analyzer.stop()
        if self._anim:
            GLib.source_remove(self._anim)
            self._anim = None

    def animate(self):
        on_media = self.stack.get_visible_child_name() == "media"
        (self.media_spectrum if on_media else self.spectrum).tick()
        self._anim_n += 1
        if on_media and self._anim_n % 10 == 0:
            self.media.tick()
            n = len(self.media.cards)
            self.media_count.set_text(f"MPRIS · {n} PLAYER" + ("" if n == 1 else "S"))
            pl, pr = self.analyzer.peak
            self.media_peak.set_text(f"PEAK {fmt_db(max(pl, pr), ' dBFS')}")
        if self._anim_n % 40 == 0:
            self.media.resync_positions()
        if self._anim_n % 3 == 0:
            pl, pr = self.analyzer.peak
            top = max(pl, pr)
            self.peak_lbl.set_text("-∞" if top == float("-inf") else f"{top:.1f}")
            self.lr_lbl.set_text(f"L {fmt_db(pl, '')}  ·  R {fmt_db(pr, '')}")
            live = top > -60
            self.live_chip.set_text("● SIGNAL" if live else "○ SILENCE")
            set_class(self.live_chip, "live", live)
        return True

    # ---------------- events
    def toggle_window(self):
        if self.win.get_visible() and self.win.is_active():
            self.win.hide()
        else:
            self.show_window()

    def on_close(self, *a):
        if self.tray.is_embedded():
            self.win.hide()
            return True
        self.quit()
        return False

    def on_tray_scroll(self, _icon, ev):
        d = ev.direction
        if d == Gdk.ScrollDirection.SMOOTH:
            _, dx, dy = ev.get_scroll_deltas()
            step = -5 if dy > 0 else 5
        else:
            step = 5 if d == Gdk.ScrollDirection.UP else -5
        self.nudge(step)

    def on_tray_menu(self, icon, button, time):
        menu = Gtk.Menu()
        player = self.media.primary()
        if player:
            title = " ".join(str(player.meta.get("xesam:title") or player.identity).split())
            it = Gtk.MenuItem(label=("❚❚  " if player.status == "Playing" else "▶  ") + title[:40])
            it.connect("activate", lambda *a: player.call("PlayPause"))
            menu.append(it)
            menu.append(Gtk.SeparatorMenuItem())
        for text, cb in (("Show window", self.show_window),
                         ("Toggle mute", self.toggle_mute),
                         ("Reset to 100%", lambda: self.apply_preset(100))):
            it = Gtk.MenuItem(label=text)
            it.connect("activate", lambda _i, f=cb: f())
            menu.append(it)
        menu.append(Gtk.SeparatorMenuItem())
        q = Gtk.MenuItem(label="Quit")
        q.connect("activate", lambda *a: self.quit())
        menu.append(q)
        menu.show_all()
        menu.popup(None, None, Gtk.StatusIcon.position_menu, icon, button, time)

    def on_key(self, _w, ev):
        k = Gdk.keyval_name(ev.keyval)
        if k in ("Tab", "ISO_Left_Tab"):
            self.stack.set_visible_child_name(
                "audio" if self.stack.get_visible_child_name() == "media" else "media")
            return True
        if self.stack.get_visible_child_name() == "media":
            p = self.media.primary()
            if p and k == "space":
                p.call("PlayPause")
                return True
            if p and k in ("Left", "Right"):
                p.seek_by(SEEK_STEP if k == "Right" else -SEEK_STEP)
                return True
            if p and k in ("n", "N", "p", "P"):
                p.call("Next" if k in ("n", "N") else "Previous")
                return True
        if k in ("Up", "Right", "plus", "KP_Add"):
            self.nudge(5)
        elif k in ("Down", "Left", "minus", "KP_Subtract"):
            self.nudge(-5)
        elif k in ("m", "M"):
            self.toggle_mute()
        elif k in ("1", "2", "3"):
            self.apply_preset(int(k) * 100)
        elif k == "Escape":
            self.on_close()
        else:
            return False
        return True

    def on_device(self, combo):
        if self._building_combo:
            return
        name = combo.get_active_id()
        if not name or name == self.sink:
            return
        pactl("set-default-sink", name)
        # move playing applications to the new device too
        for idx in self.app_rows:
            pactl("move-sink-input", idx, name, wait=False)
        self.schedule_refresh()

    # ---------------- volume actions
    def set_master(self, v):
        if self.sink:
            if self.muted and v > 0:
                pactl("set-sink-mute", self.sink, "0", wait=False)
            pactl("set-sink-volume", self.sink, f"{v}%", wait=False)

    def apply_preset(self, v):
        self.main_slider._quiet_until = 0
        self.main_slider.set_value(v)

    def nudge(self, step):
        self.apply_preset(clamp(self.main_slider.get_value() + step))

    def toggle_mute(self):
        if self.sink:
            pactl("set-sink-mute", self.sink, "toggle", wait=False)

    def set_mic(self, v):
        if self.source:
            pactl("set-source-volume", self.source, f"{v}%", wait=False)

    def toggle_mic(self):
        if self.source:
            pactl("set-source-mute", self.source, "toggle", wait=False)

    def paint_master(self, v):
        self.big.set_text(str(v))
        db = fmt_db(pct_to_db(v))
        self.db_lbl.set_text(f"GAIN {db}")
        self.db_chip.set_text(db)
        ctx = self.hero.get_style_context()
        ctx.remove_class("boost")
        ctx.remove_class("max")
        lvl = level_class(v)
        if lvl:
            ctx.add_class(lvl)
        set_class(self.hero, "muted", self.muted)
        if self.muted:
            self.warn.set_text("◼ OUTPUT MUTED")
        elif v > 200:
            self.warn.set_text("▲ EXTREME BOOST — CLIPPING LIKELY, MIND YOUR SPEAKERS")
        elif v > 100:
            self.warn.set_text("△ SOFTWARE BOOST ACTIVE (ABOVE 100%)")
        else:
            self.warn.set_text("")
        self.warn.set_visible(bool(self.warn.get_text()))
        for p, b in self.preset_btns.items():
            set_class(b, "active", p == v)
        self.update_tray(v)

    def update_tray(self, v):
        self.tray.set_from_icon_name(vol_icon(min(v, 100), self.muted))
        self.tray.set_tooltip_text(f"Volume: {v}%" + (" (muted)" if self.muted else ""))

    # ---------------- read state
    def schedule_refresh(self):
        if not self._refresh_pending:
            self._refresh_pending = True
            GLib.timeout_add(80, self.refresh)

    def refresh(self):
        self._refresh_pending = False
        self.sinks = parse_list("sinks")
        self.sink = default_sink()
        cur = next((s for s in self.sinks if s.get("Name") == self.sink), None)

        self._building_combo = True
        self.combo.remove_all()
        for s in self.sinks:
            self.combo.append(s["Name"], s.get("Description") or s["Name"])
        if cur:
            self.combo.set_active_id(cur["Name"])
        self._building_combo = False

        if cur:
            self.muted = cur["mute"]
            self.volume = cur["volume"]
            self.main_slider.set_external(self.volume)
            self.mute_btn.set_label("UNMUTE" if self.muted else "MUTE")
            set_class(self.mute_btn, "on", self.muted)
            self.mute_btn.set_tooltip_text("Unmute (M)" if self.muted else "Mute (M)")
            self.paint_master(clamp(self.main_slider.get_value()))
            m = re.match(r"(\w+) (\d+)ch (\d+)Hz", cur.get("Sample Specification", ""))
            if m:
                self.tile_rate.set_text(f"{int(m.group(3)) / 1000:g} kHz")
                self.tile_fmt.set_text(f"{m.group(1).upper()} · {m.group(2)}CH")
            state = cur.get("State", "")
            self.tile_state.set_text(state)
            if self._anim:
                self.analyzer.start(self.sink + ".monitor")

        self.refresh_apps()
        self.refresh_mic()
        return False

    def refresh_apps(self):
        inputs = parse_list("sink-inputs")
        seen = []
        for si in inputs:
            p = si["props"]
            idx = si["index"]
            seen.append(idx)
            name = p.get("application.name") or p.get("application.process.binary") or "Application"
            sub = p.get("media.name", "")
            if idx not in self.app_rows:
                row = ChannelRow(
                    "cyan", name, sub,
                    lambda v, i=idx: pactl("set-sink-input-volume", i, f"{v}%", wait=False),
                    lambda i=idx: pactl("set-sink-input-mute", i, "toggle", wait=False))
                self.app_rows[idx] = row
                self.apps_box.pack_start(row, False, False, 0)
                row.show_all()
            n = len(seen)
            row = self.app_rows[idx]
            row.set_accent(ACCENTS[(n - 1) % len(ACCENTS)])
            row.update(si["volume"], si["mute"], f"CHANNEL {n:02d} — {name}", sub)
        for idx in list(self.app_rows):
            if idx not in seen:
                self.app_rows.pop(idx).destroy()
        self.apps_count.set_text(f"{len(self.app_rows)} ACTIVE")
        self.media.update_streams(inputs)
        self.apps_empty.set_visible(not self.app_rows)
        self.apps_empty.set_no_show_all(bool(self.app_rows))

    def refresh_mic(self):
        self.source = default_source()
        src = next((s for s in parse_list("sources") if s.get("Name") == self.source), None)
        if src:
            self.mic_row.update(src["volume"], src["mute"], sub=src.get("Description", ""))

    def do_shutdown(self):
        self.stop_analyzer()
        if self.subscriber:
            self.subscriber.terminate()
        Gtk.Application.do_shutdown(self)

    def start_subscribe(self):
        proc = subprocess.Popen(["pactl", "subscribe"], env=ENV, stdout=subprocess.PIPE,
                                text=True, preexec_fn=_die_with_parent)
        self.subscriber = proc

        def run():
            for line in proc.stdout:
                # the analyzer stream's own events (source-output, client) don't need a refresh
                if "client" not in line and "source-output" not in line:
                    GLib.idle_add(self.schedule_refresh)
        threading.Thread(target=run, daemon=True).start()


if __name__ == "__main__":
    sys.exit(SManager().run(sys.argv[:1]))
