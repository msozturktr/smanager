class VolumeSlider(Gtk.Scale):
    """Slider that ignores outside updates while the user drags it
    and throttles pactl calls."""

    def __init__(self, on_change, main=False):
        adj = Gtk.Adjustment(value=0, lower=0, upper=MAX_VOL, step_increment=1, page_increment=5)
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, adjustment=adj)
        self.set_draw_value(False)
        self.set_hexpand(True)
        self.set_round_digits(0)
        if main:
            self.get_style_context().add_class("main")
            for m, text in ((0, "0%"), (100, "100% · UNITY"), (200, "200%"), (300, "300%")):
                self.add_mark(m, Gtk.PositionType.BOTTOM, text)
        self._on_change = on_change
        self._dragging = False
        self._quiet_until = 0
        self._pending = None
        self._hid = self.connect("value-changed", self._changed)
        self.connect("button-press-event", lambda *a: setattr(self, "_dragging", True))
        self.connect("button-release-event", self._released)
        self.connect("scroll-event", self._scroll)

    def _scroll(self, _w, ev):
        # the mouse wheel scrolls the page instead of changing the volume
        sw = self.get_ancestor(Gtk.ScrolledWindow)
        if sw:
            adj = sw.get_vadjustment()
            if ev.direction == Gdk.ScrollDirection.SMOOTH:
                delta = ev.get_scroll_deltas()[2] * 60
            else:
                delta = 60 if ev.direction == Gdk.ScrollDirection.DOWN else -60
            adj.set_value(adj.get_value() + delta)
        return True

    def _released(self, *a):
        self._dragging = False
        self._quiet_until = GLib.get_monotonic_time() + 600_000

    def _changed(self, *a):
        self._quiet_until = GLib.get_monotonic_time() + 600_000
        v = clamp(self.get_value())
        if self._pending is None:
            GLib.timeout_add(35, self._flush)
        self._pending = v

    def _flush(self):
        v, self._pending = self._pending, None
        if v is not None:
            self._on_change(v)
        return False

    def set_external(self, v):
        if self._dragging or GLib.get_monotonic_time() < self._quiet_until:
            return
        if clamp(self.get_value()) == v:
            return
        self.handler_block(self._hid)
        self.set_value(v)
        self.handler_unblock(self._hid)

    def set_dim(self, dim):
        set_class(self, "dim", dim)


