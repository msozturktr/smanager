        vh.pack_end(self.vol_val, False, False, 0)
        self.vol_box.pack_start(vh, False, False, 0)
        vr = Gtk.Box(spacing=12)
        self.vol = VolumeSlider(self._set_volume)
        self.vol.connect("value-changed", lambda s: self.vol_val.set_text(f"{clamp(s.get_value())}%"))
        vr.pack_start(self.vol, True, True, 0)
        self.mute = Gtk.Button(label="M", valign=Gtk.Align.CENTER)
        for c in ("mute", "small"):
            self.mute.get_style_context().add_class(c)
        self.mute.connect("clicked", lambda *a: self._toggle_mute())
        vr.pack_start(self.mute, False, False, 0)
        self.vol_box.pack_start(vr, False, False, 0)
        self.pack_start(self.vol_box, False, False, 0)
        # widgets shown or hidden depending on the metadata: keep the window's show_all from re-showing them
        for w in (self.host, self.artist, self.album, self.raise_btn):
            w.set_no_show_all(True)
        # these two boxes are hidden depending on state: keep show_all from opening them,
        # but have their contents ready to show
        for box in (self.progress, self.vol_box):
            box.foreach(lambda w: w.show_all())
            box.set_no_show_all(True)
            box.hide()

        self.update()

    def _seek_release(self, *a):
        self._seeking = False
        if self.player.prop("CanSeek", False):
            self.player.set_position(self.seek.get_value() * 1_000_000)

    def _set_volume(self, v):
        for si in self.streams:
            pactl("set-sink-input-volume", si["index"], f"{v}%", wait=False)

    def _toggle_mute(self):
        target = "0" if all(si["mute"] for si in self.streams) else "1"
        for si in self.streams:
            pactl("set-sink-input-mute", si["index"], target, wait=False)

    def bind_streams(self, streams):
        self.streams = streams
        if streams:
            vol = max(si["volume"] for si in streams)
            muted = all(si["mute"] for si in streams)
            self.vol.set_external(vol)
            self.vol.set_dim(muted)
            self.vol_val.set_text(f"{clamp(self.vol.get_value())}%")
            set_class(self.mute, "on", muted)
        self.vol_box.set_visible(bool(streams))

    def update(self):
        p = self.player
        meta = p.meta
        title = " ".join(str(meta.get("xesam:title") or "Unknown track").split())
        artist = meta.get("xesam:artist") or []
        artist = ", ".join(artist) if isinstance(artist, list) else str(artist)
        self.title.set_text(title)
        self.artist.set_text(artist.upper())
        self.artist.set_visible(bool(artist))
        album = meta.get("xesam:album") or ""
        self.album.set_text(album)
        self.album.set_visible(bool(album))
        url = meta.get("xesam:url") or ""
        host = re.sub(r"^www\.", "", re.sub(r"^\w+://([^/]+).*", r"\1", url)) if "://" in url else ""
        self.host.set_text(host.upper())
        self.host.set_visible(bool(host))
        self.art.set_url(meta.get("mpris:artUrl") or youtube_thumb(url))

        status = p.status
        text, cls = self.STATUS.get(status, (status.upper(), None))
        self.state.set_text(text)
        for c in ("live", "violet"):
            set_class(self.state, c, c == cls)
        set_class(self, "playing", status == "Playing")
        self.play.set_image(Gtk.Image.new_from_icon_name(
            "media-playback-pause-symbolic" if status == "Playing" else "media-playback-start-symbolic",
            Gtk.IconSize.LARGE_TOOLBAR))
        self.prev.set_sensitive(p.prop("CanGoPrevious", False))
        self.next.set_sensitive(p.prop("CanGoNext", False))
        self.play.set_sensitive(p.prop("CanPlay", False) or p.prop("CanPause", False))
        can_seek = bool(p.prop("CanSeek", False))
        self.back10.set_sensitive(can_seek)
        self.fwd10.set_sensitive(can_seek)
        self.raise_btn.set_visible(bool(p._root_prop("CanRaise")))
        self.tick()

    def tick(self):
        length = self.player.length
        has = length > 0
        self.progress.set_visible(has)
        if has:
            pos = self.player.current_position()
            adj = self.seek.get_adjustment()
            adj.set_upper(length / 1_000_000)
            if not self._seeking:
                self.seek.set_value(pos / 1_000_000)
            self.t_pos.set_text(fmt_time(self.seek.get_value() * 1_000_000))
            self.t_len.set_text(fmt_time(length))
            self.seek.set_sensitive(bool(self.player.prop("CanSeek", False)))


class MediaPanel(Gtk.Box):
    """Watches MPRIS players and shows a card for each one."""

    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.cards = {}
        self.inputs = []
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.empty = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.empty.get_style_context().add_class("channel")
        self.empty.pack_start(label("NOTHING IS PLAYING", "empty", "mono", xalign=0.5,
                                    margin_bottom=0), False, False, 0)
        self.empty.pack_start(label("Start a video or song in your browser and it will show up here.",
                                    "ch-sub", xalign=0.5, margin_bottom=14), False, False, 0)
        self.pack_start(self.empty, False, False, 0)
        self.bus.signal_subscribe("org.freedesktop.DBus", "org.freedesktop.DBus", "NameOwnerChanged",
                                  "/org/freedesktop/DBus", None, Gio.DBusSignalFlags.NONE,
                                  self._owner_changed)
        names = self.bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                                   "ListNames", None, GLib.VariantType("(as)"),
                                   Gio.DBusCallFlags.NONE, 1000, None).unpack()[0]
        for n in sorted(names):
            self._add(n)
        self._sync_empty()

    def _owner_changed(self, _conn, _sender, _path, _iface, _signal, params):
        name, _old, new = params.unpack()
        if not name.startswith(MPRIS_PREFIX):
            return
        if new:
            GLib.timeout_add(300, lambda: self._add(name) and False)  # give the player a moment to get ready
        else:
            card = self.cards.pop(name, None)
            if card:
                card.destroy()
            self._sync_empty()

    def _add(self, name):
        if not name.startswith(MPRIS_PREFIX) or name in self.cards or "playerctld" in name:
            return False
        try:
            player = Player(self.bus, name, self._changed)
        except GLib.Error:
            return False
        card = PlayerCard(player)
        self.cards[name] = card
        self.pack_start(card, False, False, 0)
        card.show_all()
        card.update()
        card.bind_streams([si for si in self.inputs if player.matches(si)])
        self._sync_empty()
        self._order()
        return True

    def _changed(self, player):
        card = self.cards.get(player.name)
        if card:
            card.update()
            self._order()

    def _order(self):
        rank = {"Playing": 0, "Paused": 1}
        cards = sorted(self.cards.values(), key=lambda c: rank.get(c.player.status, 2))
        for i, c in enumerate(cards):
            self.reorder_child(c, i + 1)

    def _sync_empty(self):
        self.empty.set_visible(not self.cards)
        self.empty.set_no_show_all(bool(self.cards))

    def update_streams(self, inputs):
        self.inputs = inputs
        for card in self.cards.values():
            card.bind_streams([si for si in inputs if card.player.matches(si)])

    def tick(self):
        for card in self.cards.values():
            card.tick()

    def resync_positions(self):
        for card in self.cards.values():
            if card.player.status == "Playing" and card.player.length:
                card.player.fetch_position()

    def primary(self):
        """For keyboard/tray commands: the playing player, otherwise the first one."""
        players = [c.player for c in self.cards.values()]
        playing = [p for p in players if p.status == "Playing"]
        return (playing or players or [None])[0]


