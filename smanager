        for w in (self.back10, self.prev, self.play, self.next, self.fwd10):
            ctrls.pack_start(w, False, False, 0)
        self.pack_start(ctrls, False, False, 0)

        # app volume (PulseAudio stream)
        self.vol_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        vh = Gtk.Box()
        vh.pack_start(label("APP VOLUME", "tile-label", "mono"), True, True, 0)
