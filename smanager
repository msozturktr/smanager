def level_class(v):
    return "max" if v > 200 else "boost" if v > 100 else None


def vol_icon(v, muted):
    if muted or v == 0:
        return "audio-volume-muted"
    if v < 34:
        return "audio-volume-low"
    if v < 67:
        return "audio-volume-medium"
    return "audio-volume-high"


def pct_to_db(v):
    # PulseAudio/PipeWire software volume is cubic: dB = 60·log10(v/100)
    return 60 * math.log10(v / 100) if v > 0 else float("-inf")


def fmt_db(db, unit=" dB"):
    if db == float("-inf"):
        return "-∞" + unit
    return f"{db:+.1f}{unit}"


def label(text="", *classes, xalign=0.0, **kw):
    if "chip" in classes:
        kw.setdefault("valign", Gtk.Align.CENTER)
    lbl = Gtk.Label(label=text, xalign=xalign, **kw)
    ctx = lbl.get_style_context()
    for c in classes:
        ctx.add_class(c)
    return lbl


def set_class(widget, cls, on):
    ctx = widget.get_style_context()
    (ctx.add_class if on else ctx.remove_class)(cls)


# ---------------------------------------------------------------- analysis

class Analyzer:
    """Reads the default output's monitor with `parec` and computes
    FFT bands and left/right peak levels."""

    RATE = 48000
    N = 2048      # ~23 Hz resolution; the real-FFT trick reduces it to an N/2 complex FFT
    BANDS = 28
    LO_HZ, HI_HZ = 40, 16000
    FLOOR_DB = -72

    def __init__(self):
        n = self.N
        m = n // 2
        self.window = [0.5 - 0.5 * math.cos(2 * math.pi * i / (n - 1)) for i in range(n)]
        self.rev = [int(f"{i:0{m.bit_length() - 1}b}"[::-1], 2) for i in range(m)]
        self.post = [cmath.exp(-2j * math.pi * k / n) for k in range(m)]
        self.twiddles = []
        size = 2
        while size <= m:
            self.twiddles.append((size, [cmath.exp(-2j * math.pi * k / size) for k in range(size // 2)]))
            size *= 2
        ratio = self.HI_HZ / self.LO_HZ
        edges = [self.LO_HZ * ratio ** (i / self.BANDS) for i in range(self.BANDS + 1)]
        self.bins = []
        for lo, hi in zip(edges, edges[1:]):
            a = max(1, round(lo * n / self.RATE))
            b = max(a + 1, round(hi * n / self.RATE))
            self.bins.append((a, b))
        self.ref = 65536 * n / 4  # magnitude of a full-scale sine (L+R) after the Hann window
        self.levels = [0.0] * self.BANDS
        self.peak = [float("-inf")] * 2
        self.proc = None
        self.device = None

    def start(self, device):
        if self.proc and self.device == device:
            return
        self.stop()
        self.device = device
        try:
            self.proc = subprocess.Popen(
                ["parec", "-d", device, "--format=s16le", f"--rate={self.RATE}", "--channels=2",
                 "--latency-msec=20", "--client-name=smanager-analyzer"],
                env=ENV, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                preexec_fn=_die_with_parent)
        except OSError:
            self.proc = None
            return
        threading.Thread(target=self._run, args=(self.proc,), daemon=True).start()

    def stop(self):
        if self.proc:
            self.proc.terminate()
            self.proc = None
        self.device = None
        self.levels = [0.0] * self.BANDS
        self.peak = [float("-inf")] * 2

    def _run(self, proc):
        # 2048-frame blocks ≈ 23 per second; process every other one (~12/s) to stay light on old CPUs
        size = self.N * 4
        skip = False
        while self.proc is proc:
            buf = proc.stdout.read(size)
            if len(buf) < size:
                break
            if not skip:
                self._process(buf)
            skip = not skip

    def _fft(self, a):
        rev = self.rev
        a = [a[rev[i]] for i in range(len(a))]
        for size, w in self.twiddles:
            half = size // 2
            for start in range(0, len(a), size):
                for k in range(half):
                    i, j = start + k, start + k + half
                    v = a[j] * w[k]
                    u = a[i]
                    a[i] = u + v
                    a[j] = u - v
        return a

    def _process(self, buf):
        s = array.array("h")
        s.frombytes(buf)
        left, right = s[0::2], s[1::2]
        peaks = []
        for ch in (left, right):
            p = max(max(ch), -min(ch))
            peaks.append(20 * math.log10(p / 32768) if p else float("-inf"))
        self.peak = peaks
        if peaks[0] == peaks[1] == float("-inf"):
            self.levels = [0.0] * self.BANDS
            return
        w = self.window
        x = [(left[i] + right[i]) * w[i] for i in range(self.N)]
        # real input: pack even/odd samples into one complex sequence
        z = self._fft([complex(x[2 * i], x[2 * i + 1]) for i in range(self.N // 2)])
        m = len(z)
        post = self.post
        mags = []
        for k in range(m):
            a, b = z[k], z[-k % m].conjugate()
            mags.append(abs((a + b) * 0.5 - 0.5j * post[k] * (a - b)))
        levels = []
        for a, b in self.bins:
            m = max(mags[a:b])
            db = 20 * math.log10(m / self.ref) if m > 0 else self.FLOOR_DB
            levels.append(min(1.0, max(0.0, (db - self.FLOOR_DB) / -self.FLOOR_DB)))
        self.levels = levels


class Spectrum(Gtk.DrawingArea):
    """FFT bars plus left/right peak meters on the right."""

    GRID_DB = (-12, -24, -48)
    FREQ_LABELS = ((50, "50Hz"), (200, "200Hz"), (1000, "1kHz"), (5000, "5kHz"), (15000, "15kHz"))

    def __init__(self, analyzer, compact=False):
        super().__init__()
        self.an = analyzer
        self.compact = compact
        self.set_size_request(-1, 60 if compact else 170)
        self.show_bars = [0.0] * analyzer.BANDS
        self.caps = [0.0] * analyzer.BANDS
        self.meters = [0.0, 0.0]
        self._was_active = True
        self.connect("draw", self.on_draw)

    def tick(self):
        for i, v in enumerate(self.an.levels):
            self.show_bars[i] = v if v > self.show_bars[i] else self.show_bars[i] * 0.8
            self.caps[i] = v if v > self.caps[i] else max(0.0, self.caps[i] - 0.018)
        for i, db in enumerate(self.an.peak):
            v = 0.0 if db == float("-inf") else max(0.0, min(1.0, (db + 60) / 60))
            self.meters[i] = v if v > self.meters[i] else self.meters[i] * 0.85
        active = max(self.show_bars + self.caps + self.meters) > 0.002
        if active or self._was_active:
            self.queue_draw()
        self._was_active = active

    @staticmethod
    def _mix(t):
        # cyan → magenta → violet → cyan, as in the design
        stops = (CYAN, MAGENTA, VIOLET, CYAN)
        t = t * (len(stops) - 1)
        i = min(int(t), len(stops) - 2)
        f = t - i
        a, b = stops[i], stops[i + 1]
        return tuple(a[k] + (b[k] - a[k]) * f for k in range(3))

    def on_draw(self, _w, cr):
        alloc = self.get_allocation()
        w, h = alloc.width, alloc.height
        meter_w = 44
        gw, gh = (w, h) if self.compact else (w - meter_w - 8, h - 18)

        cr.select_font_face("JetBrains Mono")
        cr.set_font_size(9)

        # grid lines
        cr.set_line_width(1)
        cr.set_source_rgba(0.58, 0.64, 0.72, 0.10)
        for db in self.GRID_DB:
            y = int(gh * (db / Analyzer.FLOOR_DB)) + 0.5
            cr.move_to(0, y)
            cr.line_to(gw, y)
        cr.stroke()

        # bars
        n = len(self.show_bars)
        slot = gw / n
        bw = max(2.0, slot * 0.62)
        r = bw / 2
        for i, v in enumerate(self.show_bars):
            x = i * slot + (slot - bw) / 2
            bh = max(bw, v * (gh - 4))
            y = gh - bh
            col = self._mix(i / (n - 1))
            g = cairo.LinearGradient(0, y, 0, gh)
            g.add_color_stop_rgba(0, *col, 0.95)
            g.add_color_stop_rgba(1, *col, 0.18)
            cr.set_source(g)
            cr.new_sub_path()
            cr.arc(x + r, y + r, r, math.pi, 1.5 * math.pi)
            cr.arc(x + bw - r, y + r, r, 1.5 * math.pi, 2 * math.pi)
            cr.line_to(x + bw, gh)
            cr.line_to(x, gh)
            cr.close_path()
            cr.fill()
            # peak cap
            cy = gh - self.caps[i] * (gh - 4)
            cr.set_source_rgba(*col, 0.9)
            cr.rectangle(x, cy - 2, bw, 1.5)
            cr.fill()

        if self.compact:
            return

        # grid labels (on top of the bars, right side)
        for db in self.GRID_DB:
            y = gh * (db / Analyzer.FLOOR_DB)
            text = f"{db} dB"
            ext = cr.text_extents(text)
            cr.set_source_rgba(0.016, 0.027, 0.05, 0.75)
            cr.rectangle(gw - ext.width - 6, y - ext.height - 4, ext.width + 6, ext.height + 3)
            cr.fill()
            cr.set_source_rgba(0.39, 0.45, 0.55, 1)
            cr.move_to(gw - ext.width - 3, y - 3)
            cr.show_text(text)

        # frequency labels
        lo, hi = Analyzer.LO_HZ, Analyzer.HI_HZ
        cr.set_source_rgba(0.39, 0.45, 0.55, 1)
        for f, text in self.FREQ_LABELS:
            x = gw * math.log(f / lo) / math.log(hi / lo)
            ext = cr.text_extents(text)
            cr.move_to(min(max(0, x - ext.width / 2), gw - ext.width), h - 3)
            cr.show_text(text)

        # L / R meters
        mx = w - meter_w
        for k, (name, v) in enumerate(zip(("L", "R"), self.meters)):
            x = mx + 6 + k * 20
            cr.set_source_rgba(1, 1, 1, 0.08)
            self._round_rect(cr, x, 0, 10, gh, 5)
            cr.fill()
            if v > 0:
                g = cairo.LinearGradient(0, gh, 0, 0)
                g.add_color_stop_rgb(0, *CYAN)
                g.add_color_stop_rgb(0.7, *VIOLET)
                g.add_color_stop_rgb(1, *MAGENTA)
                cr.set_source(g)
                self._round_rect(cr, x, gh - v * gh, 10, v * gh, 5)
                cr.fill()
            cr.set_source_rgba(0.58, 0.64, 0.72, 1)
            cr.move_to(x + 2, h - 3)
            cr.show_text(name)

    @staticmethod
    def _round_rect(cr, x, y, w, h, r):
        r = min(r, h / 2, w / 2)
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 1.5 * math.pi)
        cr.close_path()


