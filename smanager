MPRIS_PREFIX = "org.mpris.MediaPlayer2."
MPRIS_PATH = "/org/mpris/MediaPlayer2"
PLAYER_IFACE = "org.mpris.MediaPlayer2.Player"
ROOT_IFACE = "org.mpris.MediaPlayer2"
SEEK_STEP = 10_000_000  # 10 s (microseconds)


def fmt_time(us):
    s = max(0, int(us // 1_000_000))
    h, rem = divmod(s, 3600)
    m, s = divmod(rem, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"


def youtube_thumb(url):
    m = re.search(r"(?:youtube\.com/(?:watch\?(?:.*&)?v=|shorts/|embed/)|youtu\.be/)([\w-]{11})", url or "")
    return f"https://i.ytimg.com/vi/{m.group(1)}/hqdefault.jpg" if m else None


class Player:
    """A single MPRIS player (browser tab, Spotify, VLC...)."""

    def __init__(self, bus, name, on_change):
        self.bus = bus
        self.name = name
        self.on_change = on_change
        flags = Gio.DBusProxyFlags.GET_INVALIDATED_PROPERTIES
        self.proxy = Gio.DBusProxy.new_sync(bus, flags, None, name, MPRIS_PATH, PLAYER_IFACE, None)
        self.root = Gio.DBusProxy.new_sync(bus, flags, None, name, MPRIS_PATH, ROOT_IFACE, None)
        self.identity = self._root_prop("Identity") or name[len(MPRIS_PREFIX):].split(".")[0]
        self.desktop = (self._root_prop("DesktopEntry") or "").lower()
        self.short = name[len(MPRIS_PREFIX):].split(".")[0].lower()
        try:
            self.pid = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                                     "GetConnectionUnixProcessID", GLib.Variant("(s)", (name,)),
                                     GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, 500, None).unpack()[0]
        except GLib.Error:
            self.pid = None
        self.position = 0
        self.pos_time = GLib.get_monotonic_time()
        self.proxy.connect("g-properties-changed", self._props_changed)
        self.proxy.connect("g-signal", self._signal)
        self.fetch_position()

    def _root_prop(self, key):
        v = self.root.get_cached_property(key)
        return v.unpack() if v is not None else None

    def prop(self, key, default=None):
        v = self.proxy.get_cached_property(key)
        return v.unpack() if v is not None else default

    @property
    def status(self):
        return self.prop("PlaybackStatus", "Stopped")

    @property
    def meta(self):
        return self.prop("Metadata", {}) or {}

    @property
    def length(self):
        return int(self.meta.get("mpris:length", 0) or 0)

    def current_position(self):
        pos = self.position
        if self.status == "Playing":
            pos += (GLib.get_monotonic_time() - self.pos_time) * (self.prop("Rate", 1.0) or 1.0)
        return min(pos, self.length) if self.length else pos

    def _props_changed(self, _proxy, changed, _invalid):
        keys = changed.keys()
        if "Position" in keys:
            self._set_position(changed["Position"])
        elif "PlaybackStatus" in keys or "Metadata" in keys:
            self.fetch_position()
        self.on_change(self)

    def _signal(self, _proxy, _sender, signal, params):
        if signal == "Seeked":
            self._set_position(params.unpack()[0])
            self.on_change(self)

    def _set_position(self, us):
        self.position = int(us)
        self.pos_time = GLib.get_monotonic_time()

    def fetch_position(self):
        def done(conn, res):
            try:
                self._set_position(conn.call_finish(res).unpack()[0])
            except GLib.Error:
                pass
        self.bus.call(self.name, MPRIS_PATH, "org.freedesktop.DBus.Properties", "Get",
                      GLib.Variant("(ss)", (PLAYER_IFACE, "Position")), GLib.VariantType("(v)"),
                      Gio.DBusCallFlags.NONE, 500, None, done)

    def call(self, method, args=None):
        self.proxy.call(method, args, Gio.DBusCallFlags.NONE, 1000, None, None)

    def seek_by(self, us):
        self.call("Seek", GLib.Variant("(x)", (int(us),)))

    def set_position(self, us):
        trackid = self.meta.get("mpris:trackid")
        if trackid:
            self.call("SetPosition", GLib.Variant("(ox)", (trackid, int(us))))
            self._set_position(us)

    def raise_window(self):
        self.root.call("Raise", None, Gio.DBusCallFlags.NONE, 1000, None, None)

    def matches(self, si):
        """Does the given PulseAudio stream (sink-input) belong to this player?"""
        p = si["props"]
        if self.pid and p.get("application.process.id") == str(self.pid):
            return True
        names = (p.get("application.name", "") + " " + p.get("application.process.binary", "")).lower()
        return any(k and k in names for k in (self.short, self.desktop.split("-")[0]))


class AlbumArt(Gtk.DrawingArea):
    """Cover art / video thumbnail, or a neon placeholder."""

    SIZE = 116
    _cache = {}

    def __init__(self):
        super().__init__()
        self.set_size_request(self.SIZE, self.SIZE)
        self.set_valign(Gtk.Align.START)
        self.pixbuf = None
        self.url = None
        self.connect("draw", self.on_draw)

    def set_url(self, url):
        if url == self.url:
            return
        self.url = url
        self.pixbuf = None
        self.queue_draw()
        if not url:
            return
        if url in self._cache:
            self.pixbuf = self._cache[url]
            return
        if url.startswith("file://"):
            path = GLib.filename_from_uri(url)[0]
            try:
                self._loaded(url, GdkPixbuf.Pixbuf.new_from_file(path))
            except GLib.Error:
                pass
        elif url.startswith(("http://", "https://")):
            threading.Thread(target=self._download, args=(url,), daemon=True).start()

    def _download(self, url):
        import urllib.request
        try:
            with urllib.request.urlopen(url, timeout=6) as r:
                data = r.read(4_000_000)
        except OSError:
            return

        def apply():
            loader = GdkPixbuf.PixbufLoader()
            try:
                loader.write(data)
                loader.close()
                self._loaded(url, loader.get_pixbuf())
            except GLib.Error:
                pass
        GLib.idle_add(apply)

    def _loaded(self, url, pixbuf):
        self._cache[url] = pixbuf
        if url == self.url:
            self.pixbuf = pixbuf
            self.queue_draw()

    def on_draw(self, _w, cr):
        s = self.SIZE
        Spectrum._round_rect(cr, 0, 0, s, s, 22)
        cr.save()
        cr.clip()
        if self.pixbuf:
            pw, ph = self.pixbuf.get_width(), self.pixbuf.get_height()
            k = max(s / pw, s / ph)  # "cover" crop
            cr.translate((s - pw * k) / 2, (s - ph * k) / 2)
            cr.scale(k, k)
            Gdk.cairo_set_source_pixbuf(cr, self.pixbuf, 0, 0)
            cr.paint()
        else:
            g = cairo.LinearGradient(0, 0, s, s)
            g.add_color_stop_rgba(0, *CYAN, 0.35)
            g.add_color_stop_rgba(1, *VIOLET, 0.25)
            cr.set_source(g)
            cr.paint()
            # music note: two oval heads + stems + beam
            cr.set_source_rgba(0.9, 0.98, 1, 0.85)
            for hx, hy in ((s * 0.36, s * 0.66), (s * 0.66, s * 0.60)):
                cr.save()
                cr.translate(hx, hy)
                cr.scale(1.25, 1)
                cr.arc(0, 0, s * 0.075, 0, 2 * math.pi)
                cr.restore()
                cr.fill()
            cr.set_line_width(s * 0.035)
            cr.move_to(s * 0.36 + s * 0.08, s * 0.66)
            cr.line_to(s * 0.36 + s * 0.08, s * 0.30)
            cr.move_to(s * 0.66 + s * 0.08, s * 0.60)
            cr.line_to(s * 0.66 + s * 0.08, s * 0.24)
            cr.stroke()
            cr.move_to(s * 0.36 + s * 0.08 - s * 0.017, s * 0.30)
            cr.line_to(s * 0.66 + s * 0.08 + s * 0.017, s * 0.24)
            cr.line_to(s * 0.66 + s * 0.08 + s * 0.017, s * 0.32)
            cr.line_to(s * 0.36 + s * 0.08 - s * 0.017, s * 0.38)
            cr.close_path()
            cr.fill()
        cr.restore()
        Spectrum._round_rect(cr, 0.5, 0.5, s - 1, s - 1, 22)
        cr.set_source_rgba(*CYAN, 0.35)
        cr.set_line_width(1)
        cr.stroke()


